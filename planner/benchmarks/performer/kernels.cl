
#pragma OPENCL EXTENSION cl_khr_fp64 : enable
__kernel void pf_q_proj(__global const float* A, __global const float* B, __global float* C, int M, int N, int K) { int tid=(int)get_global_id(0); int total=M*N; if(tid>=total)return; int row=tid/N; int col=tid-row*N; float sum=0.0f; int abase=row*K; for(int k=0;k<K;k++) sum+=A[abase+k]*B[k*N+col]; C[row*N+col]=sum; }
__kernel void pf_k_proj(__global const float* A, __global const float* B, __global float* C, int M, int N, int K) { int tid=(int)get_global_id(0); int total=M*N; if(tid>=total)return; int row=tid/N; int col=tid-row*N; float sum=0.0f; int abase=row*K; for(int k=0;k<K;k++) sum+=A[abase+k]*B[k*N+col]; C[row*N+col]=sum; }
__kernel void pf_v_proj(__global const float* A, __global const float* B, __global float* C, int M, int N, int K) { int tid=(int)get_global_id(0); int total=M*N; if(tid>=total)return; int row=tid/N; int col=tid-row*N; float sum=0.0f; int abase=row*K; for(int k=0;k<K;k++) sum+=A[abase+k]*B[k*N+col]; C[row*N+col]=sum; }
__kernel void pf_phi_q(__global const float* In, __global float* Out, int N) { int tid=(int)get_global_id(0); if(tid>=N)return; float x=In[tid]; Out[tid]=(x>0.0f?x:exp(x)); }
__kernel void pf_phi_k(__global const float* In, __global float* Out, int N) { int tid=(int)get_global_id(0); if(tid>=N)return; float x=In[tid]; Out[tid]=(x>0.0f?x:exp(x)); }
__kernel void pf_kv_reduce(__global const float* PhiK, __global const float* V, __global float* KV, int SeqLen, int DHead, int NumHeads) { int tid=(int)get_global_id(0); int total=NumHeads*DHead*DHead; if(tid>=total)return; int h=tid/(DHead*DHead); int rem=tid-h*DHead*DHead; int f=rem/DHead; int d=rem-f*DHead; int dModel=NumHeads*DHead; float sum=0.0f; for(int j=0;j<SeqLen;j++){ float pk=PhiK[j*dModel+h*DHead+f]; float vv=V[j*dModel+h*DHead+d]; sum += pk*vv; } KV[tid]=sum; }
__kernel void pf_z_reduce(__global const float* PhiK, __global float* Z, int SeqLen, int DHead, int NumHeads) { int tid=(int)get_global_id(0); int total=NumHeads*DHead; if(tid>=total)return; int h=tid/DHead; int f=tid-h*DHead; int dModel=NumHeads*DHead; float sum=0.0f; for(int j=0;j<SeqLen;j++) sum += PhiK[j*dModel+h*DHead+f]; Z[tid]=sum; }
__kernel void pf_linear_context(__global const float* PhiQ, __global const float* KV, __global const float* Z, __global float* Context, int SeqLen, int DHead, int NumHeads) { int tid=(int)get_global_id(0); int dModel=NumHeads*DHead; int total=SeqLen*dModel; if(tid>=total)return; int i=tid/dModel; int col=tid-i*dModel; int h=col/DHead; int d=col-h*DHead; float num=0.0f; float den=1e-6f; int kvBase=h*DHead*DHead; int zBase=h*DHead; for(int f=0;f<DHead;f++){ float pq=PhiQ[i*dModel+h*DHead+f]; num += pq * KV[kvBase+f*DHead+d]; den += pq * Z[zBase+f]; } Context[tid]=num * native_recip(den); }
__kernel void pf_o_proj(__global const float* A, __global const float* B, __global float* C, int M, int N, int K) { int tid=(int)get_global_id(0); int total=M*N; if(tid>=total)return; int row=tid/N; int col=tid-row*N; float sum=0.0f; int abase=row*K; for(int k=0;k<K;k++) sum+=A[abase+k]*B[k*N+col]; C[row*N+col]=sum; }
__kernel void pf_add_resid1(__global const float* A, __global const float* B, __global float* Out, int N) { int tid=(int)get_global_id(0); if(tid>=N)return; Out[tid]=A[tid]+B[tid]; }
__kernel void pf_add_resid2(__global const float* A, __global const float* B, __global float* Out, int N) { int tid=(int)get_global_id(0); if(tid>=N)return; Out[tid]=A[tid]+B[tid]; }
__kernel void pf_layernorm1(__global const float* In, __global const float* Gamma, __global const float* Beta, __global float* Out, int SeqLen, int DModel, float Eps) { int row=(int)get_global_id(0); if(row>=SeqLen)return; int base=row*DModel; float mean=0.0f; for(int j=0;j<DModel;j++) mean+=In[base+j]; mean*=native_recip((float)DModel); float var=0.0f; for(int j=0;j<DModel;j++){ float d=In[base+j]-mean; var+=d*d; } var*=native_recip((float)DModel); float inv=native_rsqrt(var+Eps); for(int j=0;j<DModel;j++) Out[base+j]=(In[base+j]-mean)*inv*Gamma[j]+Beta[j]; }
__kernel void pf_layernorm2(__global const float* In, __global const float* Gamma, __global const float* Beta, __global float* Out, int SeqLen, int DModel, float Eps) { int row=(int)get_global_id(0); if(row>=SeqLen)return; int base=row*DModel; float mean=0.0f; for(int j=0;j<DModel;j++) mean+=In[base+j]; mean*=native_recip((float)DModel); float var=0.0f; for(int j=0;j<DModel;j++){ float d=In[base+j]-mean; var+=d*d; } var*=native_recip((float)DModel); float inv=native_rsqrt(var+Eps); for(int j=0;j<DModel;j++) Out[base+j]=(In[base+j]-mean)*inv*Gamma[j]+Beta[j]; }
__kernel void pf_ff1(__global const float* A, __global const float* B, __global float* C, int M, int N, int K) { int tid=(int)get_global_id(0); int total=M*N; if(tid>=total)return; int row=tid/N; int col=tid-row*N; float sum=0.0f; int abase=row*K; for(int k=0;k<K;k++) sum+=A[abase+k]*B[k*N+col]; C[row*N+col]=sum; }
__kernel void pf_relu(__global float* X, int N) { int tid=(int)get_global_id(0); if(tid>=N)return; if(X[tid]<0.0f) X[tid]=0.0f; }
__kernel void pf_ff2(__global const float* A, __global const float* B, __global float* C, int M, int N, int K) { int tid=(int)get_global_id(0); int total=M*N; if(tid>=total)return; int row=tid/N; int col=tid-row*N; float sum=0.0f; int abase=row*K; for(int k=0;k<K;k++) sum+=A[abase+k]*B[k*N+col]; C[row*N+col]=sum; }
